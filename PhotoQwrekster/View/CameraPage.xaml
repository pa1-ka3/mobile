<phone:PhoneApplicationPage x:Class="PhotoQwrekster.CameraPage"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
                            xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            mc:Ignorable="d" d:DesignWidth="728" d:DesignHeight="480"
                            FontFamily="{StaticResource PhoneFontFamilyNormal}"
                            FontSize="{StaticResource PhoneFontSizeNormal}"
                            Foreground="{StaticResource PhoneForegroundBrush}"
                            SupportedOrientations="PortraitOrLandscape"
                            Orientation="LandscapeLeft"
                            shell:SystemTray.IsVisible="True"
                            DataContext="{Binding MainCamera, Source={StaticResource Locator}}">

	<!--LayoutRoot contains the root grid where all other page content is placed-->
	<Grid x:Name="LayoutRoot"
	      Background="Transparent">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>



        <Canvas x:Name="viewfinderCanvas" Width="480" Height="480" 
                   HorizontalAlignment="Left" >

            <!--Camera viewfinder -->
            <Canvas.Background>
                <VideoBrush x:Name="viewfinderBrush"
                             
                            />
            </Canvas.Background>

            <!-- Brackets for Touch Focus -->
            <TextBlock 
                x:Name="focusBrackets" 
                Text="[   ]"
                Canvas.Left="{Binding FocusBracketsCanvasLeft}"
                Canvas.Top="{Binding FocusBracketsCanvasTop}"
                FontSize="40"
                Visibility="{Binding FocusBracketsVisibility}"/>

        </Canvas>

        <!--Button StackPanel to the right of viewfinder>-->
        <StackPanel Grid.Column="1" >
            <Button x:Name="ShutterButton" 
                    Content="SH" 
                    Command="{Binding Path=ShutterButtonClick}"                     
                    FontSize="26" FontWeight="ExtraBold" Height="75" />
            <Button Name="FlashButton" 
                    Content="{Binding FlashButtonContent}" 
                    Command="{Binding Path=ChangeFlashClick}" 
                    FontSize="26" FontWeight="ExtraBold" Height="75"/>
            <Button Name="AFButton" 
                    Content="AF" 
                    Command="{Binding Path=FocusClick}" 
                    FontSize="26" FontWeight="ExtraBold" Height="75"/>
            <Button Content="{Binding ResButtonContent}" 
                    Name="ResButton" 
                    Command="{Binding Path=ChangeResClick}" 
                    FontSize="26" 
                    FontWeight="ExtraBold" Height="75"/>
            <Button Command="{Binding Path=SelectFacebookCommand}" 
                    Content="Facebook" />
           
        </StackPanel>

        <!--Used for debugging >-->
        <TextBlock Text="{Binding TextDebug}"
                   Height="40" 
                   HorizontalAlignment="Left"
                   Margin="8,428,0,0" 
                   Name="txtDebug" 
                   VerticalAlignment="Top"                    
                   Width="626" FontSize="24" FontWeight="ExtraBold" />

       
       
	</Grid>
    
