<phone:PhoneApplicationPage x:Class="PhotoQwrekster.CameraPage"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
                            xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:conv="clr-namespace:PhotoQwrekster.Converters"
                            mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="768"
                            FontFamily="{StaticResource PhoneFontFamilyNormal}"
                            FontSize="{StaticResource PhoneFontSizeNormal}"
                            Foreground="{StaticResource PhoneForegroundBrush}"
                            SupportedOrientations="Portrait"
                            Orientation="Portrait"
                            shell:SystemTray.IsVisible="True"
                            shell:SystemTray.BackgroundColor="{StaticResource SystemTrayColor}"
                            DataContext="{Binding MainCamera, Source={StaticResource Locator}}">
    
    
	<phone:PhoneApplicationPage.Resources>
		<Style x:Key="RoundCornerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CameraButtonColorBrush}"/>
			<Setter Property="BorderBrush" Value="{StaticResource PhoneForegroundBrush}"/>
			<Setter Property="Foreground" Value="{StaticResource PhoneForegroundBrush}"/>
			<Setter Property="BorderThickness" Value="{StaticResource PhoneBorderThickness}"/>
			<Setter Property="FontFamily" Value="{StaticResource PhoneFontFamilySemiBold}"/>
			<Setter Property="FontSize" Value="{StaticResource PhoneFontSizeMediumLarge}"/>
			<Setter Property="Padding" Value="1,1,1,1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid Background="Transparent">
							<Grid.RowDefinitions>
								<RowDefinition Height="0.688*"/>
								<RowDefinition Height="0.312*"/>
							</Grid.RowDefinitions>
							<VisualStateManager.VisualStateGroups>
								<VisualStateGroup x:Name="CommonStates">
									<VisualState x:Name="Normal"/>
									<VisualState x:Name="MouseOver"/>
									<VisualState x:Name="Pressed">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="ContentContainer">
												<DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PhoneBackgroundBrush}"/>
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background" Storyboard.TargetName="ButtonBackground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF202020"/>
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
									<VisualState x:Name="Disabled">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="ContentContainer">
												<DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PhoneDisabledBrush}"/>
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background" Storyboard.TargetName="ButtonBackground">
												<DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
								</VisualStateGroup>
							</VisualStateManager.VisualStateGroups>
							<Border x:Name="ButtonBackground" 
							BorderThickness="{TemplateBinding BorderThickness}" 
							Background="{TemplateBinding Background}" 
							CornerRadius="4" 
							Margin="4,2,4,2" Grid.RowSpan="2">
								<Border.BorderBrush>
                                    <SolidColorBrush Color="{StaticResource BorderColor}"/>
								</Border.BorderBrush>
								<ContentControl x:Name="ContentContainer" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" Padding="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" BorderBrush="#FF2B971C">
									
								</ContentControl>
							</Border>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
        
        <conv:FlashImageConverter x:Key="ImageConverter" />
	</phone:PhoneApplicationPage.Resources>

	<!--LayoutRoot contains the root grid where all other page content is placed-->
	<Grid x:Name="LayoutRoot" Background="{StaticResource PhoneBackgroundColorBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="64" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="64" />
		</Grid.RowDefinitions>


        <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />                    
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            <Grid.Background>
                <SolidColorBrush Color="{StaticResource SystemTrayColor}"/>
            </Grid.Background>
				
				<Button Name="FlashButton"
                        Grid.Column="0"
                        Command="{Binding Path=ChangeFlashClick}"
                         
                        Height="64"
                        Style="{StaticResource RoundCornerButton}" 
                        BorderThickness="3" HorizontalAlignment="Left" Width="160">
                    <Grid>
                        <Image  Source="{Binding Path=FlashButtonContent, Converter={StaticResource ImageConverter}}"  
                            Margin="0" Height="48" >                            
                        </Image>
                    </Grid>
				</Button>
            <Rectangle Grid.Column="1" Fill="{StaticResource CameraButtonColorBrush}" Margin="1,4,1,4">
					
				</Rectangle>
				
				<Button 
                    Grid.Column="2"
                    Name="ResButton"
                    Command="{Binding Path=ChangeResClick}" 
                    FontSize="20" 
					Style="{StaticResource RoundCornerButton}"
					HorizontalAlignment="Right"
                    Height="64" Width="160" >
                    
                        
                       
                        <TextBlock 
                                   Text="{Binding ResButtonContent}" Margin="1,5,1,7" 
								   FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        	<TextBlock.Foreground>
                        		<SolidColorBrush Color="{StaticResource ButtonTextColor}"/>
							</TextBlock.Foreground>
						</TextBlock>
								   
                
            </Button>
            
        </Grid>
			
		



        <Canvas x:Name="viewfinderCanvas" Width="480" Height="640" Grid.Row="1"	
                   HorizontalAlignment="Left" >

            <!--Camera viewfinder -->
            <Canvas.Background>
                <VideoBrush x:Name="viewfinderBrush"  />
            </Canvas.Background>
            <!-- Brackets for Touch Focus -->
            <TextBlock 
                x:Name="focusBrackets" 
                Text="[   ]"
                Canvas.Left="{Binding FocusBracketsCanvasLeft}"
                Canvas.Top="{Binding FocusBracketsCanvasTop}"
                FontSize="40"
                Foreground="{StaticResource CameraButtonColorBrush}"
                Visibility="{Binding FocusBracketsVisibility}"/>
            <TextBlock Text="{Binding TextDebug}" Height="40" Name="txtDebug" Width="626" FontSize="24" FontWeight="ExtraBold" Canvas.Left="12" Canvas.Top="560"
                       Foreground="{StaticResource CameraButtonColorBrush}" />
        </Canvas>

        <!--Button StackPanel to the right of viewfinder>-->
        
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />                    
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            
            <Button x:Name="ShutterButton"   
                    Grid.Column="0"
					
                    Command="{Binding Path=ShutterButtonClick}"                     
                    FontSize="26" FontWeight="ExtraBold" Height="64" Width="160" Style="{StaticResource RoundCornerButton}" >
                <StackPanel>
                    <Image Source="/PhotoQwrekster;component/Resources/Photo.png" Margin="0" Height="48" ></Image>
                </StackPanel>
            </Button>

            <Button Name="AFButton" 
                    Grid.Column="1"
					
                     
                    Command="{Binding Path=FocusClick}" 
					                    FontSize="26"
					Height="64" Width="160" Style="{StaticResource RoundCornerButton}" 
					 >
            	<Button.Foreground>
					<SolidColorBrush Color="{StaticResource ButtonTextColor}"/>
				</Button.Foreground>
				<Button.Content>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="14" />
							<ColumnDefinition Width="54"/>
							<ColumnDefinition Width="14" />
						</Grid.ColumnDefinitions>
						<TextBlock TextWrapping="Wrap" Text="[" FontSize="36" Grid.Column="0" VerticalAlignment="Center" TextAlignment="Left"/>
					<TextBlock TextWrapping="Wrap" Text="auto focus" FontSize="20" Grid.Column="1" TextAlignment="Center"></TextBlock>
					<TextBlock TextWrapping="Wrap" Text="]" FontSize="36" Grid.Column="2" VerticalAlignment="Center"/>
					</Grid>
				</Button.Content>      
					 </Button>
					
			<Button 			
                    Grid.Column="2"
                    Name="SkipButton" 
					
                    Command="{Binding Path=SkipClick}" 
                    
					Style="{StaticResource RoundCornerButton}"
                    
					Width="160"
					Height="64" 
					>
				<Button.Foreground>
					<SolidColorBrush Color="{StaticResource ButtonTextColor}"/>
				</Button.Foreground>
				<Button.Content>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="50"/>
							<ColumnDefinition Width="32" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" 
						Text="skip foto" 
						FontSize="20" 
						TextWrapping="Wrap" ></TextBlock>
						<TextBlock Grid.Column="1" Text=">>" VerticalAlignment="Center" FontFamily="OCR A Extended" />
					</Grid>
				</Button.Content>
	            </Button>
            
            </Grid>

        

        <!--Used for debugging >-->
    </Grid>
    
