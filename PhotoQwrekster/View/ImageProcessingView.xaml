<phone:PhoneApplicationPage x:Class="PhotoQwrekster.View.ImageProcessingView"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
                            xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:toolkit="clr-namespace:PhotoQwrekster.Input"
                            xmlns:toolkitMain="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit" 
                            xmlns:primitives="clr-namespace:PhotoQwrekster.Primitives"
                            mc:Ignorable="d"
                            d:DesignWidth="480"
                            d:DesignHeight="696"
                            FontFamily="{StaticResource PhoneFontFamilyNormal}"
                            FontSize="{StaticResource PhoneFontSizeNormal}"
                            Foreground="{StaticResource PhoneForegroundBrush}"
                            SupportedOrientations="Portrait"
                            Orientation="Portrait"
                            shell:SystemTray.IsVisible="True"
                            shell:SystemTray.BackgroundColor="{StaticResource SystemTrayColor}"
                            DataContext="{Binding ImageViewModel, Source={StaticResource Locator}}" 
                            >

    <phone:PhoneApplicationPage.Resources>
    	<SolidColorBrush Color="#FF606060" x:Key="GrayColor"/>
		
        <Style TargetType="primitives:ToggleSwitchButton" x:Name="MySwitchButton" >
            <Setter Property="Background" Value="{StaticResource PhoneBackgroundBrush}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="SwitchForeground" Value="{StaticResource PhoneAccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ToggleSwitchButton">
                        <Border
                        x:Name="Root"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CacheMode="BitmapCache"
                        Opacity="{TemplateBinding Opacity}"
                        Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ColorAnimation
                                            Storyboard.TargetName="SwitchBottom"
                                            Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
                                            Duration="0"
                                            To="{StaticResource PhoneForegroundColor}"/>
                                            <ColorAnimation
                                            Storyboard.TargetName="ThumbCenter"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            Duration="0"
                                            To="{StaticResource PhoneForegroundColor}"/>
                                            <DoubleAnimation
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Opacity"
                                            Duration="0"
                                            To="0.3"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.05" To="Unchecked"/>
                                        <VisualTransition GeneratedDuration="0:0:0.05" To="Checked"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation
                                            Storyboard.TargetName="BackgroundTranslation"
                                            Storyboard.TargetProperty="(TranslateTransform.X)"
                                            Duration="0"
                                            To="69">
                                                <DoubleAnimation.EasingFunction>
                                                    <ExponentialEase Exponent="15" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                            Storyboard.TargetName="ThumbTranslation"
                                            Storyboard.TargetProperty="(TranslateTransform.X)"
                                            Duration="0"
                                            To="69">
                                                <DoubleAnimation.EasingFunction>
                                                    <ExponentialEase Exponent="15" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Dragging"/>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation
                                            Storyboard.TargetName="BackgroundTranslation"
                                            Storyboard.TargetProperty="(TranslateTransform.X)"
                                            Duration="0"
                                            To="0"/>
                                            <DoubleAnimation
                                            Storyboard.TargetName="ThumbTranslation"
                                            Storyboard.TargetProperty="(TranslateTransform.X)"
                                            Duration="0"
                                            To="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="SwitchRoot" Background="Transparent" Height="45" Width="116">
                                <Grid x:Name="SwitchTrack" Width="89">
                                    <Grid x:Name="SwitchBottom" Background="{TemplateBinding SwitchForeground}" Height="34">
                                        <Rectangle
                                        x:Name="SwitchBackground"
                                        Fill="{TemplateBinding Background}"
                                        Width="77"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform x:Name="BackgroundTranslation"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Border BorderBrush="{StaticResource GrayColor}" BorderThickness="3">
                                            <Border BorderBrush="{StaticResource PhoneBackgroundBrush}" BorderThickness="4" Height="28" VerticalAlignment="Top"/>
                                        </Border>
                                    </Grid>
                                    <Border
                                    x:Name="SwitchThumb"
                                    BorderBrush="{StaticResource PhoneBackgroundBrush}"
                                    BorderThickness="4,0"
                                    Margin="-4,0"
                                    Width="28"
                                    Height="38"
                                    HorizontalAlignment="Left">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="ThumbTranslation"/>
                                        </Border.RenderTransform>
                                        <Border
                                        x:Name="ThumbCenter"
                                        BorderBrush="{StaticResource GrayColor}"
                                        BorderThickness="2"
                                        Background="{StaticResource GrayColor}"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    
	
	
    </phone:PhoneApplicationPage.Resources>

        <Grid x:Name="LayoutRoot" Background="{StaticResource PhoneBackgroundColorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--TitlePanel contains the name of the application and page title-->
        <StackPanel x:Name="TitlePanel"
                    Grid.Row="0"
                    Margin="0,0,0,0">
          <Grid><Grid.ColumnDefinitions>
        		<ColumnDefinition Width="185"></ColumnDefinition>     	
			    	<ColumnDefinition Width="110"></ColumnDefinition>     	
		    		<ColumnDefinition Width="185"></ColumnDefinition>     	
		    		<ColumnDefinition></ColumnDefinition>     	
		    	</Grid.ColumnDefinitions> 
          <TextBlock Text="transform along one axe" Grid.Column="0" TextWrapping="Wrap" 
	        		Margin="0,1,5,1"
	        		Foreground="Gray"
	        		TextAlignment="Right"	>
          </TextBlock>
            <primitives:ToggleSwitchButton Grid.Column="1" 
	      		Style="{StaticResource MySwitchButton}" 
                                            x:Name="TransformMode"
                                            Checked="TransformMode_Checked"
                                            Unchecked="TransformMode_Unchecked" 
                                           
	      		 >
            	<primitives:ToggleSwitchButton.Background>
            		<SolidColorBrush Color="{StaticResource NavyBlueColor}"/>        	
				</primitives:ToggleSwitchButton.Background>
				<primitives:ToggleSwitchButton.SwitchForeground>
            		<SolidColorBrush Color="{StaticResource NavyBlueColor}"/>        	
				</primitives:ToggleSwitchButton.SwitchForeground>       
				 </primitives:ToggleSwitchButton>
				 
				 
			<TextBlock Text="transform along both axes" Grid.Column="2" TextWrapping="Wrap"
			Foreground="Gray"
			Margin="10,1,0,1"></TextBlock>
            </Grid>
        </StackPanel>

        <!--ContentPanel - place additional content here-->
        <Grid x:Name="ContentPanel" 
              Grid.Row="1"
              Margin="0,0,0,0">
            <Image Name="imgSelectedPhoto" 
                   Width="480" Height="640"
                   Stretch="Fill" 
                   Tap="imgSelectedPhoto_Tap"
                   MouseLeftButtonDown="imgSelectedPhoto_MouseLeftButtonDown"
               Visibility="Visible" d:LayoutOverrides="VerticalMargin" >

                <toolkit:GestureService.GestureListener>
                    <toolkit:GestureListener
                        PinchStarted="OnPinchStarted"                        
                        PinchDelta="OnPinchDelta" 
                        PinchCompleted="OnPinchCompleted"/>
                </toolkit:GestureService.GestureListener>

            </Image>
            <Line x:Name="Line1" X1="10" Y1="10" X2="120" Y2="210" Stroke="#FFF51313" Visibility="Collapsed"></Line>
            <Line x:Name="Line2" X1="10" Y1="120" X2="120" Y2="20" Stroke="#FFF51313" Visibility="Collapsed"></Line>


            <TextBlock x:Name="flickData" Text="try to transform image with gesture" Foreground="{StaticResource CameraButtonColorBrush}"
                       Style="{StaticResource PhoneTextNormalStyle}" VerticalAlignment="Bottom" Height="40" 
                       TextWrapping="Wrap" FontSize="24" FontWeight="ExtraBold" Margin="12,0,12,40" />
            <!-- First ellipse, non transformable -->
            <Ellipse Name="GestureElipse" 
                     Margin="0,130,-200,-200" 
                     Visibility="Visible" 
                    
                     VerticalAlignment="Top" 
                     HorizontalAlignment="Left" 
                     RenderTransformOrigin="0.5, 0.5"
                      
                     Width="480"
                     Height="240"
                     >
                <Ellipse.Fill>
                    <RadialGradientBrush   
                        GradientOrigin="0.5,0.5" 
                        Center="0.5,0.5"                         
                        RadiusX="0.5" 
                        RadiusY="0.5">
                        <RadialGradientBrush.GradientStops>
                            <GradientStop Color="#FFFF8300" Offset="0" />
                            <GradientStop Color="#01FFC0CB" 
                                          Offset="1" />
                        </RadialGradientBrush.GradientStops>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            
            <!--Transformable ellipse -->
            <Ellipse Name="TransformElipse" 
                     Margin="0,130,-200,-200" 
                     Visibility="Visible" 
                    
                     VerticalAlignment="Top" 
                     HorizontalAlignment="Left" 
                     RenderTransformOrigin="0.5, 0.5"
                     Stroke="Red" 
                     StrokeThickness="2"
                     Width="480"
                     Height="240"
                     >
                
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="transform" Rotation="0" />
                </Ellipse.RenderTransform>
            </Ellipse>

 <!--           <toolkitMain:PerformanceProgressBar x:Name="performanceProgressBar" IsIndeterminate="True" Height="11" Width="470" Visibility="Visible" >
            </toolkitMain:PerformanceProgressBar>
-->
        </Grid>
        

        <Popup x:Name="save_panel" IsOpen="False">
            <Border  BorderThickness="2" Margin="10" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{StaticResource BorderColor}"/>
                </Border.BorderBrush>
                <StackPanel Background="{StaticResource CameraButtonColorBrush}" >

                    <TextBlock Text="save image as:" TextAlignment="Left" FontSize="32" Margin="10,0"  Foreground="{StaticResource ButtonTextColorBrush}" />
                    <TextBox x:Name="ImageNameEditBox" Margin="10,10"></TextBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <Button x:Name="btn_save_continue"  
                                Content="save" Width="215" 
                                Click="btn_save_continue_Click" 
                                BorderBrush="{StaticResource DialogButtonborderColorBrush}" 
                                Background="{StaticResource DialogButtonColorBrush}"  
                                Foreground="{StaticResource ButtonTextColorBrush}"/>
                        <Button x:Name="btn_cancel"    
                                Content="cancel"   Width="215" 
                                Click="btn_save_cancel_Click" 
                                BorderBrush="{StaticResource DialogButtonborderColorBrush}" 
                                Background="{StaticResource DialogButtonColorBrush}"  
                                Foreground="{StaticResource ButtonTextColorBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
            
        <Popup x:Name="save_overwrite_prompt" IsOpen="False">
            <Border  BorderThickness="2" Margin="10" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{StaticResource BorderColor}"/>
                </Border.BorderBrush>
                <StackPanel Background="{StaticResource CameraButtonColorBrush}" >

                    <TextBlock x:Name="OverwritePromt" Height="80" Width="415" Text="save image in camera as:" TextAlignment="Left" FontSize="32" Margin="10,0"  Foreground="{StaticResource ButtonTextColorBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <Button x:Name="btn_save_overwrite"  
                                Content="overwrite" Width="215" 
                                Click="btn_save_overwrite_Click" 
                                BorderBrush="{StaticResource DialogButtonborderColorBrush}" 
                                Background="{StaticResource DialogButtonColorBrush}"  
                                Foreground="{StaticResource ButtonTextColorBrush}"/>
                        <Button x:Name="btn_overwrite_cancel"    
                                Content="cancel"   Width="215" 
                                Click="btn_overwrite_cancel_Click" 
                                BorderBrush="{StaticResource DialogButtonborderColorBrush}" 
                                Background="{StaticResource DialogButtonColorBrush}"  
                                Foreground="{StaticResource ButtonTextColorBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

      
    </Grid>

    <!--Sample code showing usage of ApplicationBar-->
    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="False" BackgroundColor="{StaticResource ApplicationBarBackgroundColor}" ForegroundColor="Black">
            <shell:ApplicationBarIconButton x:Name="Load" IconUri="/Resources/OpenFile.png" Text="Load" Click="Load_Click"/>
            <shell:ApplicationBarIconButton x:Name="Save" IconUri="/Resources/AppBarSave.png" Text="Save" Click="Save_Click" />
            <shell:ApplicationBarIconButton x:Name="Undo" IconUri="/Resources/Undo.png" Text="Undo" Click="Undo_Click"/>
            <shell:ApplicationBarIconButton x:Name="Share" IconUri="/Resources/Share.png" Text="Share" Click="Share_Click" />
            
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

</phone:PhoneApplicationPage>