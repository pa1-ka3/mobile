<phone:PhoneApplicationPage 
    x:Class="PhotoQwrekster.View.OAuthFlickrLogin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    mc:Ignorable="d"
    d:DesignWidth="480"
    d:DesignHeight="768"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait"
    Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    DataContext="{Binding ViewModelName, Source={StaticResource Locator}}">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <phone:WebBrowser x:Name="Browser"
                          IsScriptEnabled="True"                                                            
                          Navigating="Browser_Navigating"
                          Navigated="Browser_Navigated"
                          NavigationFailed="Browser_NavigationFailed"
                          IsGeolocationEnabled="True"
                          Visibility="Visible"
                              />
        <StackPanel Name="connectTitle"
                    Orientation="Vertical" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Center">
            <TextBlock Text="connecting..." HorizontalAlignment="Center" 
                       FontSize="{StaticResource PhoneFontSizeNormal}"
                       Style="{StaticResource PhoneTextNormalStyle}"/>
            <toolkit:PerformanceProgressBar x:Name="progressBar" IsIndeterminate="True"/>
        </StackPanel>

    </Grid>

</phone:PhoneApplicationPage>